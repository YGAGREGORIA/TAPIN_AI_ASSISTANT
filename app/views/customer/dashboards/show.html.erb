<div class="container mt-4">
  <div class="row mb-4">
    <div class="col-12">
      <h1>Welcome back, <%= @user.first_name %>!</h1>
      <p class="text-muted"><%= @studio&.name %></p>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Total Check-ins</h5>
          <p class="display-4"><%= @total_check_ins %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Current Tier</h5>
          <p class="display-4"><%= @tier %></p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card text-center">
        <div class="card-body">
          <h5 class="card-title">Rewards Earned</h5>
          <p class="display-4"><%= @user_rewards.select(&:redeemed).count %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-12">
      <h3>Reward Progress</h3>
    </div>
    <% @user_rewards.each do |ur| %>
      <div class="col-md-6 mb-3">
        <div class="card">
          <div class="card-body">
            <h6><%= ur.reward.name %></h6>
            <% pct = ur.reward.required_checkins > 0 ? (ur.progress.to_f / ur.reward.required_checkins * 100).round : 0 %>
            <div class="progress">
              <div class="progress-bar" role="progressbar" style="width: <%= pct %>%">
                <%= ur.progress %>/<%= ur.reward.required_checkins %>
              </div>
            </div>
            <% if ur.redeemed %>
              <span class="badge bg-success mt-2">Earned!</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="col-12">
      <h3>Recent Check-ins</h3>
      <% if @recent_check_ins.any? %>
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Studio</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_check_ins.each do |ci| %>
              <tr>
                <td><%= ci.created_at.strftime("%B %d, %Y at %l:%M %p") %></td>
                <td><%= ci.studio.name %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No check-ins yet. Visit a studio to get started!</p>
      <% end %>
    </div>
  </div>
</div>

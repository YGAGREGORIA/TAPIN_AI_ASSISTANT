<nav class="navbar navbar-expand-lg tapin-navbar">
  <div class="container-fluid">

    <!-- Logo -->
    <%= link_to root_path, class: "navbar-brand tapin-brand d-flex align-items-center" do %>
      <span class="tapin-logo-text">TAPIN<span class="dot">.</span></span>
    <% end %>

    <!-- Mobile toggle -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

      <!-- Left navigation -->
      <ul class="navbar-nav me-auto tapin-nav-links">

        <li class="nav-item">
          <%= link_to "Home", root_path,
          class: "nav-link #{'active' if current_page?(root_path)}" %>
        </li>

        <li class="nav-item">
          <%= link_to "AI Assistant", chats_path,
          class: "nav-link #{'active' if request.path.start_with?('/chats')}" %>
        </li>

      </ul>

      <!-- Right navigation -->
      <ul class="navbar-nav ms-auto align-items-center">

  <% if user_signed_in? %>

    <li class="nav-item">
      <%= button_to "Log out",
      destroy_user_session_path,
      method: :delete,
      class: "tapin-logout-btn" %>
    </li>
        <% else %>

        <li class="nav-item">
          <%= link_to "Sign in",
          new_user_session_path,
          class: "nav-link" %>
        </li>

        <li class="nav-item ms-lg-3">
          <%= link_to "Sign up",
          new_user_registration_path,
          class: "tapin-btn-primary" %>
        </li>

        <% end %>

      </ul>

    </div>
  </div>
</nav>

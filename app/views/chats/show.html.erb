<div class="chat-wrapper" data-controller="chat-shell" data-chat-shell-chat-id-value="<%= @chat.id %>">

  <%# ── Header bar ── %>
  <div class="d-flex align-items-center gap-2 px-3 py-2 bg-white border-bottom">
    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill"
            data-action="click->chat-shell#openSidebar">
      <i class="fas fa-bars me-1"></i> History
    </button>
    <span class="fw-semibold"><%= @chat.title %></span>
    <div class="ms-auto">
      <%= button_to chats_path, method: :post, class: "btn btn-sm btn-primary rounded-pill" do %>
        <i class="fas fa-plus me-1"></i> New chat
      <% end %>
    </div>
  </div>

  <%# ── Messages area ── %>
  <div class="chat-messages" data-chat-shell-target="messages">

    <% if defined?(@messages) && @messages.present? %>
      <% @messages.each do |m| %>
        <% if m.role == "user" %>
          <div class="d-flex justify-content-end align-items-end gap-2 mb-3">
            <div class="chat-bubble chat-bubble-user"><%= m.content %></div>
            <div class="chat-avatar chat-avatar-user">You</div>
          </div>
        <% else %>
          <div class="d-flex justify-content-start align-items-end gap-2 mb-3">
            <div class="chat-avatar chat-avatar-ai">AI</div>
            <div class="chat-bubble chat-bubble-assistant"><%= m.content %></div>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <%# Welcome state %>
      <div class="chat-welcome" data-chat-shell-target="welcome">
        <div class="chat-avatar chat-avatar-ai mx-auto mb-3" style="width:48px;height:48px;font-size:1rem;">AI</div>
        <h4>Hi<%= current_user.first_name.present? ? ", #{current_user.first_name}" : "" %>!</h4>
        <p>I'm your TapIn assistant. Ask me about your check-ins, rewards, classes, or deals.</p>
      </div>

      <%# Suggestion chips %>
      <div class="suggestion-chips" data-chat-shell-target="suggestions">
        <button class="suggestion-chip" data-action="click->chat-shell#sendSuggestion" data-message="How many check-ins do I have?">
          <i class="fas fa-check-circle"></i> My check-ins
        </button>
        <button class="suggestion-chip" data-action="click->chat-shell#sendSuggestion" data-message="What rewards can I unlock?">
          <i class="fas fa-trophy"></i> Rewards
        </button>
        <button class="suggestion-chip" data-action="click->chat-shell#sendSuggestion" data-message="Recommend a class for me">
          <i class="fas fa-dumbbell"></i> Classes
        </button>
        <button class="suggestion-chip" data-action="click->chat-shell#sendSuggestion" data-message="Show me current deals">
          <i class="fas fa-tags"></i> Deals
        </button>
      </div>
    <% end %>

    <%# Typing indicator (hidden by default) %>
    <div class="d-flex align-items-end gap-2 mb-3 d-none" data-chat-shell-target="typing">
      <div class="chat-avatar chat-avatar-ai">AI</div>
      <div class="typing-indicator">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>
    </div>
  </div>

  <%# ── Input area ── %>
  <div class="chat-input-area">
    <form class="d-flex align-items-center gap-2" data-action="submit->chat-shell#send">
      <input type="text"
             name="message"
             class="form-control chat-input"
             placeholder="Type a message..."
             autocomplete="off"
             data-chat-shell-target="input">
      <button type="submit" class="btn btn-primary chat-send-btn" data-chat-shell-target="sendBtn">
        <i class="fas fa-paper-plane"></i>
      </button>
    </form>
  </div>

  <%# ── Sidebar overlay ── %>
  <div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-none"
       style="z-index: 1060;"
       data-chat-shell-target="overlay"
       data-action="click->chat-shell#closeSidebar">
  </div>

  <%# ── Sidebar ── %>
  <aside class="position-fixed top-0 start-0 bg-white h-100 shadow-lg chat-sidebar"
         data-chat-shell-target="sidebar">
    <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
      <div>
        <div class="fw-semibold">Your chats</div>
        <div class="text-muted small"><%= @chats.size %> conversation<%= @chats.size == 1 ? '' : 's' %></div>
      </div>
      <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
              data-action="click->chat-shell#closeSidebar" style="width:32px;height:32px;padding:0;">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="p-2">
      <%= button_to chats_path, method: :post, class: "btn btn-primary w-100 rounded-pill mb-2" do %>
        <i class="fas fa-plus me-1"></i> New chat
      <% end %>
    </div>

    <div class="list-group list-group-flush overflow-auto px-2" style="height: calc(100% - 140px);">
      <% @chats.each do |chat| %>
        <%= link_to chat_path(chat),
              class: "list-group-item list-group-item-action border-0 rounded-3 mb-1 #{'active' if @chat && chat.id == @chat.id}" do %>
          <div class="fw-semibold text-truncate"><%= chat.title %></div>
          <div class="text-muted small"><%= time_ago_in_words(chat.updated_at) %> ago</div>
        <% end %>
      <% end %>
    </div>
  </aside>
</div>
